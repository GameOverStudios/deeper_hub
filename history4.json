    );

    CREATE INDEX IF NOT EXISTS idx_bx_market_photos_entry_id ON bx_market_photos(entry_id);
    CREATE INDEX IF NOT EXISTS idx_bx_market_photos_file_id ON bx_market_photos(file_id);
    \"\"\"

    case Repo.execute(sql) do
