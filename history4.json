    {
      \"data\": [
        {
          \"id\": 12, \"org_id\": 201, \"profile_id\": 55, \"role\": \"editor\", \"added\": 1678895000,
          \"profile_summary\": { \"profile_id\": 55, \"display_name\": \"Member One\", \"avatar_url\": \"...\" }
        }
        // ... mais membros
      ],
      \"pagination\": { ... }
    }
