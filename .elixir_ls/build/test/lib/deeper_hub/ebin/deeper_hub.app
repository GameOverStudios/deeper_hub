                        'Elixir.DeeperHub.Core.EventManager.Subscriber',
                        'Elixir.DeeperHub.Core.Logger',
                        'Elixir.DeeperHub.Core.Logger.Subscribers.LogEventsSubscriber',
                        'Elixir.DeeperHub.Core.Telemetry.Adapters.CacheAdapter',
                        'Elixir.DeeperHub.Core.Telemetry.Adapters.DatabaseAdapter',
                        'Elixir.DeeperHub.Core.Telemetry.Adapters.HttpAdapter',
