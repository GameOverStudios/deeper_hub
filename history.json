      Name TEXT NOT NULL UNIQUE,
      Icon TEXT NOT NULL DEFAULT '',
      Description TEXT NOT NULL DEFAULT '',
      Active TEXT NOT NULL DEFAULT 'no' CHECK(Active IN ('yes', 'no')), -- SQLite não tem tipo BOOLEAN, usar TEXT ou INTEGER
