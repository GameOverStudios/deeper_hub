# Configurações de Banco de Dados
DATABASE_PATH=/app/data/deeper_hub.db
POOL_SIZE=10

# Configurações de Segurança
SECRET_KEY_BASE=your_secret_key_base_here_generate_with_mix_phx_gen_secret
GUARDIAN_SECRET_KEY=your_guardian_secret_here_generate_with_mix_guardian_gen_secret

# Configurações HTTP
PORT=4000
HOST=localhost
FORCE_SSL=true

# Configurações de Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Configurações de Cache (opcional)
REDIS_URL=redis://localhost:6379/0

# Configurações de Logging
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/deeper_hub/app.log

# Configurações de Desenvolvimento
MIX_ENV=dev

# Configurações de Produção
# MIX_ENV=prod
# DATABASE_PATH=/app/data/deeper_hub_prod.db
# LOG_LEVEL=warn