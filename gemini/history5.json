      {:ok, _} -> Logger.info(\"Tabela deeper_votes_track removida com sucesso.\", module: __MODULE__)
      {:error, reason} -> Logger.error(\"Falha ao remover tabela deeper_votes_track: #{inspect(reason)}\", module: __MODULE__)
    end)
