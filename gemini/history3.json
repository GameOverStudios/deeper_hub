          {:ok, _} ->
            Logger.info(\"Tabela sys_accounts removida com sucesso.\", module: __MODULE__)
            :ok
          {:error, reason} ->
            Logger.error(\"Falha ao remover tabela sys_accounts: #{inspect(reason)}\", module: __MODULE__)
            {:error, reason}
        end
      end
    end
