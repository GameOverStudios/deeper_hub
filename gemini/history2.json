    CREATE TABLE IF NOT EXISTS sys_form_pre_values (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      \"Key\" TEXT NOT NULL, -- Chave da lista (FK para sys_form_pre_lists.\"key\")
      \"Value\" TEXT NOT NULL, -- Valor real do item da lista
