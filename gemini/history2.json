        Logger.info(\"Tabela sys_pages_blocks removida com sucesso.\", module: __MODULE__)
        :ok
      {:error, reason} ->
        Logger.error(\"Falha ao remover tabela sys_pages_blocks: #{inspect(reason)}\", module: __MODULE__)
        {:error, reason}
    end
  end
end
