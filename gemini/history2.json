    CREATE TABLE IF NOT EXISTS sys_menu_templates (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      template TEXT NOT NULL UNIQUE,
      title TEXT NOT NULL,
      visible INTEGER NOT NULL DEFAULT 1 -- 0 ou 1
    );
    \"\"\"

