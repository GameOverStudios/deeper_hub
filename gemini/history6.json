      filter_get TEXT DEFAULT 'filter',
      sorting_fields TEXT,
      visible_for_levels INTEGER NOT NULL DEFAULT 2147483647,
      responsive INTEGER NOT NULL DEFAULT 1,
      show_total_count INTEGER NOT NULL DEFAULT 1
    );
    \"\"\"
    case Repo.execute(sql) do
